# ==============================================================================
# KONFIGURASI WAJIB BOT PEMBAYARAN TELEGRAM (vps-bot)
# Salin file ini menjadi .env lalu isi dengan nilai rahasia milik Anda.
# JANGAN PERNAH commit file .env ke repository.
# ==============================================================================

# Token bot Telegram dari @BotFather — WAJIB DIISI
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Chat ID admin/telegram Anda (angka) — WAJIB DIISI
ADMIN_CHAT_ID=8971674377

# Supabase URL & SERVICE ROLE KEY (hanya untuk backend bot) — WAJIB DIISI
# Ambil service role key dari Dashboard Supabase > Settings > API
SUPABASE_URL=https://api.ujianpintar.online
SUPABASE_SERVICE_ROLE_KEY=

# WAHA WhatsApp HTTP API (opsional, jika tidak diisi notifikasi WA dinonaktifkan)
# Default Windows: http://103.150.226.233:3080 — Default VPS Linux: http://localhost:3080
WAHA_BASE_URL=
WAHA_API_KEY=