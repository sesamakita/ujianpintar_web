# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# KEAMANAN: Jangan masukkan SERVICE_ROLE_KEY dengan awalan VITE_ karena akan ter-inline ke bundle publik.
# Gunakan SUPABASE_SERVICE_ROLE_KEY hanya di sisi server/VPS (vps-bot/.env).
# VITE_WAHA_BASE_URL=https://api.ujianpintar.online/waha
# VITE_WAHA_API_KEY=your-waha-api-key-here

# Telegram payment bot config (used by vps-bot; keep empty in public builds)
# VITE_TELEGRAM_BOT_TOKEN=
# VITE_TELEGRAM_CHAT_ID=
